# ============================================================================
# KZDI Talent OS Enterprise v3.0 — Environment Configuration
# ============================================================================

# AI Gateway
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_MS=1000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram (KzMentorBot alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ENABLE_TELEGRAM_NOTIFICATIONS=true

# Runtime
DEBUG=false
DRY_RUN=false
NODE_ENV=development

# Observability
ENABLE_AI_TELEMETRY=true
LOG_PROMPTS=false
LOG_RESPONSES=false
